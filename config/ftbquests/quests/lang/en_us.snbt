	quest.5C11000000000060.quest_subtitle: "Hold one Kinetic Assembly"
	quest.5C11000000000060.quest_desc: [
		"A pressed andesite casing packed with grease and rods: the standard drive unit of every Groundbreaking contraption."
		""
		"The Board certifies the first unit in your hands: pick it up again if it went straight into a chest. Every unit after this one is worth the terminal price of a Kinetic Assembly."
		""
		"&7Certification bonus: 5.00 CC and 50 XP, paid to the crew member holding the item.&r"
	]
	task.5C11000000000061.title: "Kinetic Assembly"
	reward.5C11000000000064.title: "Certification bonus: 5.00 CC"
	reward.5C11000000000065.title: "Certification bonus: 50 XP"

