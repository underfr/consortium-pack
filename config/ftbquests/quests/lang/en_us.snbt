	chapter.5C11000000000001.chapter_subtitle: [
		"The manufactured products of phase 1: Kinetic Assembly, Provisions Crate."
	]
	chapter.5C11000000000001.title: "Board Orders 1: Groundbreaking"

	quest.5C11000000000010.title: "Board Orders, Phase 1"
	quest.5C11000000000010.quest_subtitle: "Groundbreaking: the manufactured products"
	quest.5C11000000000010.quest_desc: [
		"The Board does not only buy raw materials. Each phase it orders manufactured products, one per pillar of the phase, and every product crosses several mods: a roadmap of machines that no single department owns."
		""
		"This chapter is one lane per product: the steps in order, the first unit you hold, then the delivery run that counts toward the quota line. Prices are the terminal's; the first unit and the run pay a bonus on top."
		""
		"&7Every step here is a task on the item it makes or on the part it needs; recipes are in JEI once the phase is open.&r"
	]
	task.5C11000000000011.title: "Phase 1 open"

	quest.5C11000000000020.title: "Grease the works"
	quest.5C11000000000020.quest_subtitle: "Kinetic Assembly, step 1 of 4"
	quest.5C11000000000020.quest_desc: [
		"Press seeds in a basin (compacting) for seed oil, drain a hive or a bottle for honey, and mix 250 mB of seed oil, 100 mB of honey and a charcoal in a basin under a mechanical mixer: two Machine Grease. No heat needed."
		""
		"&7Create: Crafts and Additions, Create. Machine: mechanical mixer.&r"
		""
		"&7Step bonus: 17 XP.&r"
	]
	task.5C11000000000021.title: "Grease the works"
	reward.5C11000000000024.title: "Step bonus: 17 XP"

	quest.5C11000000000030.title: "Press the casing"
	quest.5C11000000000030.quest_subtitle: "Kinetic Assembly, step 2 of 4"
	quest.5C11000000000030.quest_desc: [
		"Sequenced assembly on an andesite casing, two loops: a press, a spout of 100 mB of seed oil, a press. A Pressed Casing comes off the belt, with the odd bit of scrap."
		""
		"&7Create. Machine: mechanical press.&r"
		""
		"&7Step bonus: 17 XP.&r"
	]
	task.5C11000000000031.title: "Press the casing"
	reward.5C11000000000034.title: "Step bonus: 17 XP"

	quest.5C11000000000040.title: "Roll the rods"
	quest.5C11000000000040.quest_subtitle: "Kinetic Assembly, step 3 of 4"
	quest.5C11000000000040.quest_desc: [
		"A rolling mill turns one iron ingot into two iron rods. Four go into every assembly."
		""
		"&7Create: Crafts and Additions. Machine: rolling mill.&r"
		""
		"&7Step bonus: 17 XP.&r"
	]
	task.5C11000000000041.title: "Roll the rods"
	reward.5C11000000000044.title: "Step bonus: 17 XP"

	quest.5C11000000000050.title: "Assemble"
	quest.5C11000000000050.quest_subtitle: "Kinetic Assembly, step 4 of 4"
	quest.5C11000000000050.quest_desc: [
		"Grease in the corners, a rod on each side, a shaft above and below the pressed casing: one Kinetic Assembly."
		""
		"&7Create, Create: Crafts and Additions. Machine: crafting table.&r"
		""
		"&7Step bonus: 17 XP.&r"
	]
	task.5C11000000000051.title: "Assemble"
	reward.5C11000000000054.title: "Step bonus: 17 XP"

