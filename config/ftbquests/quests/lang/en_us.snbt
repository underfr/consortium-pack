	quest.5C11000000000070.quest_subtitle: "Deliver 4 Kinetic Assemblys"
	quest.5C11000000000070.quest_desc: [
		"The phase 1 quota asks for 40 Kinetic Assemblys from the whole server. This assignment counts your own deliveries at the terminal: 4 units, the daily cap of the line notwithstanding."
		""
