	chapter.5C12000000000001.title: "Board Orders 2: The Foundry"

	quest.5C12000000000010.title: "Board Orders, Phase 2"
	quest.5C12000000000010.quest_subtitle: "The Foundry: the manufactured products"
	quest.5C12000000000010.quest_desc: [
		"The Board does not only buy raw materials. Each phase it orders manufactured products, one per pillar of the phase, and every product crosses several mods: a roadmap of machines that no single department owns."
		""
		"This chapter is one lane per product: the steps in order, the first unit you hold, then the delivery run that counts toward the quota line. Prices are the terminal's; the first unit and the run pay a bonus on top."
		""
		"&7Every step here is a task on the item it makes or on the part it needs; recipes are in JEI once the phase is open.&r"
	]
	task.5C12000000000011.title: "Phase 2 open"

	quest.5C12000000000020.title: "Cast the blank"
	quest.5C12000000000020.quest_subtitle: "Steel Manifold, step 1 of 4"
	quest.5C12000000000020.quest_desc: [
		"Melt steel in the foundry (or alloy it there from molten iron and carbon) and pour 270 mB over a plate cast on the casting table: a Manifold Blank, three ingots of steel in one piece."
		""
		"&7Productive Metalworks. Machine: casting table.&r"
		""
		"&7Step bonus: 25 XP.&r"
	]
	task.5C12000000000021.title: "Cast the blank"
	reward.5C12000000000024.title: "Step bonus: 25 XP"

