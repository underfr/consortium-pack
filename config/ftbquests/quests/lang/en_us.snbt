	quest.5C15000000000010.title: "Board Orders, Phase 5"
	quest.5C15000000000010.quest_subtitle: "Event Horizon: the manufactured products"
	quest.5C15000000000010.quest_desc: [
		"The Board does not only buy raw materials. Each phase it orders manufactured products, one per pillar of the phase, and every product crosses several mods: a roadmap of machines that no single department owns."
		""
		"This chapter is one lane per product: the steps in order, the first unit you hold, then the delivery run that counts toward the quota line. Prices are the terminal's; the first unit and the run pay a bonus on top."
		""
		"&7Every step here is a task on the item it makes or on the part it needs; recipes are in JEI once the phase is open.&r"
	]
	task.5C15000000000011.title: "Phase 5 open"

	quest.5C15000000000020.title: "Frame it in calorite"
