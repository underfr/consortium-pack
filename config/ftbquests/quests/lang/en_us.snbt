	quest.5C2B000000000010.title: "Workshop Department"
	quest.5C2B000000000010.quest_subtitle: "Dark Utilities, FTB Ultimine, Lootr and the quality-of-life mods"
	quest.5C2B000000000010.quest_desc: [
		"The small mods that change the day: vein mining, per-player loot chests, mob plates, elevators, recipe arrows, a trash slot. None of it needs a clearance."
		""
		"Two lanes: the field tools, the base tools."
		""
		"&7Read and tick this note to open the lanes. Every objective pays experience; the diploma at the end pays credits.&r"
	]
