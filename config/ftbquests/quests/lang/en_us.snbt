	quest.5C2B000000000020.title: "Ultimine"
	quest.5C2B000000000020.quest_subtitle: "Read the Ultimine note"
	quest.5C2B000000000020.quest_desc: [
		"Hold the Ultimine key (default the tilde key, change it in Controls) while mining: up to 16 connected blocks of the same kind, with a real tool, hunger per block, and mining stops before the tool breaks. Shapes cycle with the key."
		""
